generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Url {
  id BigInt @id
  shortCode String @unique
  originalUrl String 
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([expiresAt])
}

enum Tier {
  FREE
  PRO
}

model ApiKey {
  id        String   @id @default(uuid())
  hashedKey String   @unique
  tier      Tier     @default(FREE)
  createdAt DateTime @default(now())
}